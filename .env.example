# Example environment file for TalkPipe Vault
# Copy this to .env and customize for your deployment

# Host directory to watch for new documents
VAULT_WATCH_DIR=./watch

# Directory where vault storage (LanceDB & Whoosh indices) will be persisted
VAULT_PATH=./vault

# Web server configuration
VAULT_HOST=0.0.0.0
VAULT_PORT=8002

# Optional: AI provider configuration
# OPENAI_API_KEY=sk-your-key-here
# OLLAMA_BASE_URL=http://host.containers.internal:11434
