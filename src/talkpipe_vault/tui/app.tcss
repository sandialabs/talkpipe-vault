/* TalkPipe Vault TUI — visual theme.
   Deep-teal primary echoing the web app, soft panels, and a layout that
   fits in 80x24: no vertical margins in the workspace, flexible panes. */

Screen {
    background: $surface;
}

.hidden {
    display: none;
}

.muted {
    color: $text-muted;
}

.status-line {
    height: auto;
    min-height: 1;
    color: $text-muted;
}

.status-line.error {
    color: $error;
}

.status-line.success {
    color: $success;
}

.section-heading {
    text-style: bold;
    color: $primary;
    margin-top: 1;
}

/* ---- Frame -------------------------------------------------------------- */

#topbar {
    height: 1;
    background: $primary;
    color: $text;
    padding: 0 1;
}

#brand {
    width: auto;
    text-style: bold;
}

#vault-name {
    width: 1fr;
    margin: 0 1;
    text-align: center;
    text-style: italic;
}

#vault-facts {
    width: auto;
}

#tabs {
    height: 1fr;
}

TabPane {
    padding: 0 1;
}

/* ---- Forms ---------------------------------------------------------------- */

.form-row {
    height: auto;
}

.form-col {
    width: 1fr;
    height: auto;
    margin-right: 1;
}

.field-label {
    color: $text-muted;
}

Input, Select {
    margin: 0;
}

.form-row Input {
    width: 1fr;
}

.form-row Button {
    width: auto;
    min-width: 12;
}

.button-row {
    height: 3;
    align: left middle;
}

.button-row Button {
    margin-right: 1;
    min-width: 10;
    width: auto;
}

.button-row Static {
    width: auto;
    height: 3;
    content-align: left middle;
    margin-left: 1;
}

Screen.compact .button-row Static {
    height: 1;
}

.button-row Checkbox {
    width: auto;
}

/* The result-count / error labels end their rows; clipped with an ellipsis
   rather than spilling past 80 columns. */
#search-note, #kw-note {
    width: 1fr;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

Checkbox {
    height: auto;
    margin: 0;
    padding: 0 1;
    border: none;
    background: transparent;
}

/* Textual draws an *unchecked* toggle's inner glyph in $panel-darken-2 over
   $panel — a dark "X" inside a dark box. It is meant to be faint, but it
   stays legible, so an unticked option reads as ticked; checked and unchecked
   then differ only in the mark's colour, which is no difference at all on a
   terminal without 24-bit colour. That is worst on "Overwrite existing
   index", where the wrong reading costs an index. Paint the off-state glyph
   in the box's own colour so it is genuinely absent, and make the on-state
   mark bold so its presence carries the state. */
Checkbox > .toggle--button {
    color: $panel;
    background: $panel;
}

Checkbox.-on > .toggle--button {
    color: $text-success;
    background: $panel;
    text-style: bold;
}

/* ---- Vault tab -------------------------------------------------------------- */

#vault-scroll {
    height: 1fr;
}

#recent-vaults {
    height: 1fr;
    min-height: 3;
    border: round $primary-darken-2;
    background: $panel;
}

#index-progress {
    height: auto;
    color: $warning;
}

/* ---- Search / Keywords -------------------------------------------------------- */

.results-pane {
    height: 1fr;
}

.results-list {
    width: 2fr;
    height: 1fr;
    max-height: 100%;
    border: round $primary-darken-2;
    background: $panel;
}

.result-detail {
    width: 3fr;
    height: 1fr;
    border: round $secondary;
    background: $panel;
    padding: 0 1;
}

.result-detail-title {
    text-style: bold;
    color: $secondary;
}

/* ---- Ask ------------------------------------------------------------------------ */

#question {
    /* Grows with a wrapped question so the whole of it stays readable. */
    height: auto;
    min-height: 3;
    max-height: 7;
    border: round $primary-darken-1;
    background: $panel;
}

#question:focus {
    border: round $primary;
}

#answer-pane {
    height: 3fr;
    border: round $secondary;
    background: $panel;
    padding: 0 1;
}

#answer-meta {
    color: $text-muted;
}

#answer {
    /* The pane already pads; the Markdown widget's own 2-cell padding would
       double it. The pane's panel background shows through. */
    padding: 0;
    background: transparent;
}

#citations {
    height: 2fr;
    min-height: 4;
}

/* ---- Settings ------------------------------------------------------------------ */

#settings-scroll {
    height: 1fr;
}

#config-status {
    height: auto;
    border: round $primary-darken-2;
    background: $panel;
    padding: 0 1;
}

/* ---- Compact terminals ---------------------------------------------------------- */

Screen.compact .button-row {
    height: 1;
}

Screen.compact .button-row Button {
    min-width: 8;
    border: none;
    height: 1;
}

Screen.compact #citations {
    min-height: 3;
}

ModalScreen.compact .dialog-buttons Button {
    min-width: 8;
    border: none;
    height: 1;
}

ModalScreen.compact .dialog-textarea {
    min-height: 2;
}

/* Short terminals (16 rows): drop the dialogs' explanatory prose and the
   vertical spacing so the editor/list and every button stay on screen. */
ModalScreen.compact .dialog {
    padding: 0 1;
    max-height: 100%;
}

ModalScreen.compact .dialog-tall {
    height: 100%;
}

ModalScreen.compact .dialog-title {
    margin-bottom: 0;
}

ModalScreen.compact .dialog-buttons {
    margin-top: 0;
}

ModalScreen.compact .dialog-help {
    display: none;
}

ModalScreen.compact #picker-list {
    min-height: 3;
}

.checkbox-column {
    height: auto;
}

/* ---- Dialogs --------------------------------------------------------------------- */

ModalScreen {
    align: center middle;
    background: $background 60%;
}

.dialog {
    width: 70;
    max-width: 100%;
    height: auto;
    max-height: 95%;
    padding: 1 2;
    border: round $primary;
    background: $panel;
}

.dialog-wide {
    width: 96;
}

.dialog-tall {
    height: 90%;
}

.dialog-tall .dialog-body {
    height: 1fr;
    max-height: 100%;
}

.dialog-title {
    text-style: bold;
    color: $primary;
    margin-bottom: 1;
}

.dialog-body {
    height: auto;
    max-height: 30;
    margin-bottom: 1;
}

.dialog Label {
    color: $text-muted;
}

.dialog-buttons {
    height: auto;
    margin-top: 1;
    align: left middle;
}

.dialog-buttons Button {
    margin-right: 1;
}

.dialog-textarea {
    height: 1fr;
    min-height: 3;
    max-height: 12;
}

.dialog OptionList {
    height: auto;
    max-height: 20;
    border: round $primary-darken-2;
    background: $surface;
}

OptionList > .option-list--option-highlighted {
    background: $primary;
    color: $text;
}

#picker-list {
    height: 1fr;
    min-height: 5;
    max-height: 100%;
}

#recent-vaults {
    max-height: 100%;
}
